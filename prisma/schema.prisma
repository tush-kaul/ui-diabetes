// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patients {
  id           String        @id @default(cuid())
  phoneNumber  String        @unique
  ipd          String
  opd          String
  age          Int
  gender       String
  status       String

  hba1cEntries HbA1cEntry[]  @relation("PatientEntries")
}

model HbA1cEntry {
  id          String     @id @default(cuid())
  phoneNumber String

  patient     Patients   @relation("PatientEntries", fields: [phoneNumber], references: [phoneNumber])

  value       Float
  testDate    DateTime
  labName     String
  notes       String?    // Optional

  zone        String
  alertLevel  String

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}